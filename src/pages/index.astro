---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE } from 'astrowind:config';
import { ENTREPRISE } from '~/config/entreprise';
import { whatsappUrl } from '~/utils/contact';
import { localBusinessSchema } from '~/utils/localBusiness';
import { chargerRealisations } from '~/utils/chargerRealisations';

const siteUrl = new URL(`${(SITE.base ?? '/').replace(/\/?$/, '/')}`, SITE.site).href;
const lienDevis = whatsappUrl(ENTREPRISE.telephone, ENTREPRISE.messageDevis);
const realisations = chargerRealisations();
const photoAccueil = realisations[0];

const metadata = {
  title: `${ENTREPRISE.nom} · ${ENTREPRISE.accroche}`,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={localBusinessSchema(siteUrl)} />

  <Hero
    id="accueil"
    actions={[
      { variant: 'primary', text: 'Demander un devis sur WhatsApp', href: lienDevis, target: '_blank', icon: 'tabler:brand-whatsapp' },
      { variant: 'secondary', text: 'Voir nos réalisations', href: '#realisations' },
    ]}
    image={{ src: photoAccueil.src, alt: photoAccueil.alt }}
  >
    <Fragment slot="title">
      {ENTREPRISE.nom}
      <span class="tifinagh block mt-2 text-3xl md:text-4xl text-muted" lang="kab-Tfng">{ENTREPRISE.nomTifinagh}</span>
    </Fragment>
    <Fragment slot="subtitle">{ENTREPRISE.accroche}. Conception, fabrication et pose.</Fragment>
  </Hero>
</Layout>
